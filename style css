
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
    overflow-x: hidden;
}

.topbar {
    height: 58px;
    padding: 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #111;
    position: sticky;
    top: 0;
    z-index: 10;
}

.topbar h2 {
    color: #ffffff;
    font-size: 26px;
    font-weight: bold;
}

button {
    border: none;
    cursor: pointer;
    color: white;
    background: transparent;
}

.topbar button {
    font-size: 27px;
    margin-left: 15px;
}

#feed {
    padding-bottom: 65px;
}

.reel {
    position: relative;
    height: calc(100dvh - 123px);
    min-height: 450px;
    background: #171717;
    overflow: hidden;
}

.reel video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.reel-info {
    position: absolute;
    bottom: 25px;
    left: 15px;
    right: 75px;
    z-index: 2;
    text-shadow: 0 1px 5px black;
}

.reel-info h3 {
    font-size: 17px;
    margin-bottom: 9px;
}

.reel-info p {
    font-size: 14px;
    line-height: 1.5;
}

.actions {
    position: absolute;
    right: 12px;
    bottom: 35px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    z-index: 3;
}

.actions button {
    font-size: 27px;
    text-shadow: 0 1px 5px black;
}

.likeBtn span {
    font-size: 13px;
}

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 65px;
    background: #111;
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 20;
}

.bottom-nav button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 23px;
}

.bottom-nav small {
    font-size: 10px;
    color: #cccccc;
}
