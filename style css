
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
    overflow: hidden;
}

.topbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 55px;
    padding: 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0,0,0,0.85);
    z-index: 20;
}

.topbar h2 {
    font-size: 26px;
    font-weight: bold;
    color: white;
}

button {
    border: none;
    background: transparent;
    color: white;
    cursor: pointer;
}

.topbar button {
    font-size: 26px;
    margin-left: 14px;
}

#feed {
    position: fixed;
    top: 55px;
    bottom: 65px;
    width: 100%;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
}

#feed::-webkit-scrollbar {
    display: none;
}

.reel {
    width: 100%;
    height: 100%;
    min-height: 100%;
    position: relative;
    background: #171717;
    scroll-snap-align: start;
    overflow: hidden;
}

.reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.reel-info {
    position: absolute;
    bottom: 25px;
    left: 15px;
    right: 75px;
    z-index: 2;
    text-shadow: 0 1px 5px black;
}

.reel-info h3 {
    font-size: 17px;
    margin-bottom: 9px;
}

.reel-info p {
    font-size: 14px;
    line-height: 1.5;
}

.actions {
    position: absolute;
    right: 12px;
    bottom: 35px;
    display: flex;
    flex-direction: column;
    gap: 23px;
    z-index: 3;
}

.actions button {
    font-size: 27px;
    text-shadow: 0 1px 5px black;
}

.likeBtn span {
    font-size: 13px;
}

.likeBtn.liked {
    color: #ff3155;
}

.bottom-nav {
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 65px;
    background: #111;
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 20;
}

.bottom-nav button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 23px;
}

.bottom-nav small {
    font-size: 10px;
    color: #ccc;
}
